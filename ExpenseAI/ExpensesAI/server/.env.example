# Backend Environment Variables for ExpenseAI

# OpenAI API Key (get from https://platform.openai.com/api-keys)
# or Gemini API Key if you are using Gemini instead.
# Required to enable AI-powered expense analysis and chat.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default: 4000)
SERVER_PORT=4000

# NOTE: To set up real AI:
# 1. Get your OpenAI or Gemini API key.
# 2. Copy this file to .env.local
# 3. Replace the placeholder values with your actual keys.
# 4. Start the server: npm run dev:server
# The frontend will automatically proxy /api requests to this server
