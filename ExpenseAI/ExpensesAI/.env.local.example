# Copy this file to .env.local and fill with your Supabase project values

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# The service role key should only be used on server-side code, never in the browser
VITE_SUPABASE_SERVICE_ROLE=your-service-role-key

# AI backend configuration (optional if you start the server from the same environment)
# Set either OPENAI_API_KEY or GEMINI_API_KEY for expense chat and analysis.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
SERVER_PORT=4000
